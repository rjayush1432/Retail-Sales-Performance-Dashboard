                          <target field='[federated.17voxhe0zy94mi19jp0ks1umazk3].[none:CategoryName:nk]' />
                        </filter>
                      </worksheet>
                      <worksheet name='Stock Coverage Day'>
                        <filter class='categorical' column='[federated.17voxhe0zy94mi19jp0ks1umazk3].[none:CategoryName:nk]'>
                          <groupfilter function='level-members' level='[none:CategoryName:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
                          <target field='[federated.17voxhe0zy94mi19jp0ks1umazk3].[none:CategoryName:nk]' />
                        </filter>
                      </worksheet>
                      <worksheet name='Top 10 stores and products with revenue'>
                        <filter class='categorical' column='[federated.17voxhe0zy94mi19jp0ks1umazk3].[none:CategoryName:nk]'>
                          <groupfilter function='level-members' level='[none:CategoryName:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
                          <target field='[federated.17voxhe0zy94mi19jp0ks1umazk3].[none:CategoryName:nk]' />
                        </filter>
                      </worksheet>
                      <worksheet name='TopStoreRevenue'>
                        <filter class='categorical' column='[federated.17voxhe0zy94mi19jp0ks1umazk3].[none:CategoryName:nk]'>
                          <groupfilter function='level-members' level='[none:CategoryName:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
                          <target field='[federated.17voxhe0zy94mi19jp0ks1umazk3].[none:CategoryName:nk]' />
