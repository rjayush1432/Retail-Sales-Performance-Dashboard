        <zone flipboard-zone-id='5' forceUpdate='true' h='41811' hidden='true' id='6' story-point-id='8' type-v2='text' w='89900' x='4800' y='35360'>
          <formatted-text>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Tableau Light' fontsize='20'>•North and West regions </run>
            <run fontalignment='0' fontcolor='#000000' fontname='Tableau Light' fontsize='20'>contribute the highest revenue</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Tableau Light' fontsize='20'>.</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Tableau Light' fontsize='20'>• Electronics category </run>
            <run fontalignment='0' fontcolor='#000000' fontname='Tableau Light' fontsize='20'>dominates overall sales contribution (~69%).</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Tableau Light' fontsize='20'>Æ </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Tableau Light' fontsize='20'>• Electronics and Clothing </run>
            <run fontalignment='0' fontcolor='#000000' fontname='Tableau Light' fontsize='20'>products generate the highest profit margins.</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Tableau Light' fontsize='20'>Æ </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Tableau Light' fontsize='20'>• Furniture and Grocery </run>
            <run fontalignment='0' fontcolor='#000000' fontname='Tableau Light' fontsize='20'>categories show lower profitability.</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Tableau Light' fontsize='20'>Æ </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Tableau Light' fontsize='20'>• Sales demonstrate</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Tableau Light' fontsize='20'> seasonal growth </run>
            <run fontalignment='0' fontcolor='#000000' fontname='Tableau Light' fontsize='20'>with higher demand in later months. </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Tableau Light' fontsize='20'>• Inventory analysis highlights </run>
            <run fontalignment='0' fontcolor='#000000' fontname='Tableau Light' fontsize='20'>high-demand stores requiring restocking.</run>
          </formatted-text>
        </zone>
