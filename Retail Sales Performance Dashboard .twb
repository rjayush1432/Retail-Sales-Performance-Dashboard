            <zone h='78783' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='99002' x='499' y='20224'>
              <flipboard active-id='1' nav-type='caption' show-nav-arrows='true'>
                <story-points>
                  <story-point caption='Overall sales performance shows stable growth with strong contributions from Electronics and peak demand in later months.' captured-sheet='Executive Overview(Dashboard)' id='1' />
                  <story-point caption='North and West regions generate the highest revenue, while other regions contribute moderately.' captured-sheet='sum(revenue) by region' id='3' />
                  <story-point caption='Electronics and Clothing products deliver the highest margins, while Furniture and Grocery categories have lower profitability.' captured-sheet='Products Have highest Profit margin' id='4' />
                  <story-point caption='Inventory analysis highlights high-demand stores and identifies regions requiring immediate restocking.' captured-sheet='Store &amp; Inventory Performance' id='5'>
                    <capturedDeltas>
                      <worksheet name='KPI(Total Stock Quantity)'>
                        <filter class='categorical' column='[federated.17voxhe0zy94mi19jp0ks1umazk3].[none:CategoryName:nk]'>
