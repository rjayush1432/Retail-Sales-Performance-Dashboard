      <aliases enabled='yes' />
      <column datatype='integer' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([Revenue])) - LOOKUP(ZN(SUM([Revenue])), -1)'>
          <table-calc ordering-field='[federated.17voxhe0zy94mi19jp0ks1umazk3].[CategoryName]' ordering-type='Field' />
        </calculation>
      </column>
      <column caption='Total Revenue' datatype='integer' name='[Calculation_0219083014971392]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Revenue])' />
      </column>
      <column caption='Profit' datatype='integer' name='[Calculation_0538765433217025]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Revenue]) - SUM([Quantity] * [Cost])' />
      </column>
      <column caption='Profit Margin' datatype='real' name='[Calculation_0538765433675778]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Revenue]) - SUM([Quantity] * [Cost])) / SUM([Revenue])' />
      </column>
      <column caption='Monthly Growth%' datatype='real' default-format='p0%' name='[Calculation_0538765434929155]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Revenue]) - LOOKUP(SUM([Revenue]), -1))&#13;&#10;/ LOOKUP(SUM([Revenue]), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Growth Indicator' datatype='string' name='[Calculation_0538765438558212]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0538765434929155] &gt; 0 THEN &quot;▲&quot;&#13;&#10;ELSEIF [Calculation_0538765434929155] &lt; 0 THEN &quot;▼&quot;&#13;&#10;ELSE &quot;●&quot;&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Growth Color' datatype='string' name='[Calculation_0538765438746629]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0538765434929155] &gt; 0 THEN &quot;Positive&quot;&#13;&#10;ELSEIF [Calculation_0538765434929155] &lt; 0 THEN &quot;Negative&quot;&#13;&#10;ELSE &quot;Neutral&quot;&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Revenue Trend' datatype='integer' name='[Calculation_0538765441028103]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Revenue]) - LOOKUP(SUM([Revenue]), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Revenue Trend(M)' datatype='real' name='[Calculation_0538765445279754]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0538765441028103]/1000000'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Running Total Revenue' datatype='integer' name='[Calculation_0538765447880716]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([Revenue]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='AOV' datatype='real' name='[Calculation_0538765453238286]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Revenue]) / COUNT([SaleID])' />
      </column>
      <column caption='Revenue Per Store' datatype='real' name='[Calculation_0538765454106639]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Revenue]) / COUNTD([StoreID])' />
      </column>
      <column caption='Top Store' datatype='integer' name='[Calculation_0538765456945169]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(SUM([Revenue]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Product Profit Margin' datatype='real' name='[Calculation_0538765459255315]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Revenue]) - SUM([Quantity]*[Cost])) / SUM([Revenue])' />
      </column>
      <column caption='Category Contribution' datatype='real' name='[Calculation_0538765460959252]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Revenue]) / TOTAL(SUM([Revenue]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Restocking Alert' datatype='string' name='[Calculation_0538765497966617]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Quantity])&gt; WINDOW_AVG(SUM([Quantity]))&#13;&#10;then &quot;High Demand - Restock&quot;&#13;&#10;ELSE &quot;Low Demand - OK&quot;&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Revenue Normalized' datatype='real' name='[Calculation_0538765508481050]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Revenue]) / WINDOW_MAX(SUM([Revenue]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Quantity Normalized' datatype='real' name='[Calculation_0538765510139931]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Quantity]) / WINDOW_MAX(SUM([Quantity]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Price Normalized' datatype='real' name='[Calculation_0538765510287388]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Price]) / WINDOW_MAX(AVG([Price]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='AOV Normalized' datatype='real' name='[Calculation_0538765510373405]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0538765453238286] / WINDOW_MAX([Calculation_0538765453238286])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Total Inventory' datatype='integer' name='[Calculation_0910401370181632]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([CurrentStock])' />
      </column>
      <column caption='Stock Coverage' datatype='real' name='[Calculation_0910401376256001]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Quantity])/ COUNTD([Date])' />
      </column>
      <column caption='Inventory TurnOver Ratio' datatype='real' name='[Calculation_1012656415633410]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Quantity])/AVG([CurrentStock])' />
      </column>
      <column caption='Days Of Inventory Left' datatype='real' name='[Calculation_1012656415862787]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([CurrentStock])/(SUM([Quantity])/COUNTD([Date]))' />
      </column>
      <column caption='YoY Growth' datatype='real' name='[Calculation_1406830103109634]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Revenue]) - LOOKUP(SUM([Revenue]), -1)) &#13;&#10;/ ABS(LOOKUP(SUM([Revenue]), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Revenue Per Day' datatype='real' name='[Calculation_1406830147092491]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Revenue])/COUNTD([Date])' />
      </column>
      <column caption='UnderPerforming Stores Count' datatype='integer' name='[Calculation_1406830148501517]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF  sum([Revenue])&lt;WINDOW_AVG(sum([Revenue]))&#13;&#10;then 1 END'>
