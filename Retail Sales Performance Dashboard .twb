    <worksheet name='YOY Revenue growth by region'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Tableau Light'>YoY Revenue Growth by Region</run>
            <run>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sales+ (updatedDataModel)' name='federated.17voxhe0zy94mi19jp0ks1umazk3' />
          </datasources>
          <datasource-dependencies datasource='federated.17voxhe0zy94mi19jp0ks1umazk3'>
            <column caption='YoY Growth' datatype='real' name='[Calculation_1406830103109634]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Revenue]) - LOOKUP(SUM([Revenue]), -1)) &#13;&#10;/ ABS(LOOKUP(SUM([Revenue]), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Category Name' datatype='string' name='[CategoryName]' role='dimension' type='nominal' />
            <column datatype='date' name='[Date]' role='dimension' type='ordinal' />
            <column caption='Product Name' datatype='string' name='[ProductName]' role='dimension' type='nominal' />
            <column datatype='string' name='[Region]' role='dimension' type='nominal' />
            <column datatype='integer' default-format='n#,##0,,.00M;-#,##0,,.00M' name='[Revenue]' role='measure' type='quantitative' />
            <column-instance column='[Date]' derivation='Month' name='[mn:Date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[CategoryName]' derivation='None' name='[none:CategoryName:nk]' pivot='key' type='nominal' />
            <column-instance column='[Region]' derivation='None' name='[none:Region:nk]' pivot='key' type='nominal' />
            <column-instance column='[Date]' derivation='Quarter' name='[qr:Date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_1406830103109634]' derivation='User' name='[usr:Calculation_1406830103109634:qk:1]' pivot='key' type='quantitative'>
              <table-calc ordering-field='[federated.17voxhe0zy94mi19jp0ks1umazk3].[yr:Date:ok]' ordering-type='Field' />
            </column-instance>
            <column-instance column='[Date]' derivation='Year' name='[yr:Date:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.17voxhe0zy94mi19jp0ks1umazk3].[Action (Category Name)]'>
            <groupfilter function='level-members' level='[CategoryName]' user:ui-action-filter='[Action13_91A694EE4FD24D1CBD8361BE3725498B]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.17voxhe0zy94mi19jp0ks1umazk3].[Action (MONTH(Date))]'>
            <groupfilter function='level-members' level='[mn:Date:ok]' user:ui-action-filter='[Action24_6561E4689A694353A3A93CCDC77451ED]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.17voxhe0zy94mi19jp0ks1umazk3].[Action (MONTH(Date1))]'>
            <groupfilter function='level-members' level='[mn:Date:ok]' user:ui-action-filter='[Action24_6561E4689A694353A3A93CCDC77451ED]' user:ui-enumeration='all' user:ui-marker='enumerate' />
